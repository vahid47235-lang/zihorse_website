# Copy to .env.local and fill in real values. Never commit .env.local.

# Session cookie signing secret for /admin auth (src/lib/auth.ts).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# AI Import Studio — translation/understanding agent (src/lib/import/translate.ts).
OPENAI_API_KEY=
OPENAI_IMPORT_MODEL=gpt-4o-mini

# AI Import Studio + FX-rate agent — crawling agent (src/lib/apify-client.ts).
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/website-content-crawler

# Protects /api/cron/fx-rates from being triggered by anyone but Vercel Cron.
# Vercel sets this automatically for cron-triggered requests when the env
# var of the same name is configured in the project settings.
CRON_SECRET=
